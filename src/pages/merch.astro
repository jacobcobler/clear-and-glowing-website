---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

import { links } from "../data/links";

const merchValues = [
  {
    number: "01",
    title: "Represent Your Community",
    description:
      "Celebrate being part of a community that brings students together through skincare education, wellness, confidence, and connection.",
  },
  {
    number: "02",
    title: "Wear Your Confidence",
    description:
      "Carry the spirit of Clear & Glowing into your everyday life and express your connection to a mission that goes beyond appearance.",
  },
  {
    number: "03",
    title: "Share the Mission",
    description:
      "Help introduce others to Clear & Glowing and the conversations, experiences, and opportunities that bring our community together.",
  },
];
---

<Layout
  title="Shop Merch"
  description="Explore official Clear & Glowing merchandise and celebrate a community built around skincare education, confidence, wellness, and connection."
>

  <!-- ========================================
       MERCH HERO
       ======================================== -->

  <section
    class="merch-hero"
    aria-labelledby="merch-title"
  >
    <div class="page-container hero-grid">

      <!-- Hero Content -->

      <div class="hero-content">

        <p class="eyebrow">
          OFFICIAL CLEAR & GLOWING MERCH
        </p>

        <h1 id="merch-title">
          Wear the Glow.
          <span>Share the Mission.</span>
        </h1>

        <p class="hero-description">
          Show your Clear & Glowing spirit with
          merchandise made for our community.
        </p>

        <p class="hero-description">
          Whether you are representing your campus
          chapter or bringing a little glow into
          your everyday routine, explore the
          collection through our merchandise partner.
        </p>

        <div class="hero-actions">

          <Button
            href={links.merchandise}
            variant="primary"
          >
            Shop Clear & Glowing Merch
            <span aria-hidden="true">↗</span>
          </Button>

          <Button
            href="#more-than-merch"
            variant="outline"
          >
            More Than Merch
          </Button>

        </div>

        <p class="store-note">
          Shopping takes place on our external
          merchandise storefront.
        </p>

      </div>

      <!-- Branded Visual
           Replace with an approved merchandise photo
           once product assets are available. -->

      <div class="hero-visual">

        <div class="hero-visual-content">

          <p class="visual-eyebrow">
            CLEAR & GLOWING
          </p>

          <div class="visual-message">
            <p>
              WEAR
              <span>YOUR</span>
              GLOW.
            </p>
          </div>

          <div class="visual-footer">

            <p>
              CONFIDENCE LOOKS GOOD ON EVERYONE.
            </p>

            <p>
              Skincare. Wellness. Community.
            </p>

          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- ========================================
       MORE THAN MERCHANDISE
       ======================================== -->

  <section
    class="meaning-section"
    id="more-than-merch"
    aria-labelledby="meaning-title"
  >
    <div class="page-container">

      <div class="section-heading">

        <p class="eyebrow">
          MORE THAN MERCHANDISE
        </p>

        <h2 id="meaning-title">
          A Community You Can Carry With You.
        </h2>

        <p>
          Clear & Glowing is about bringing
          people together through education,
          confidence, and meaningful experiences.
          Our merchandise offers another way to
          express that connection.
        </p>

      </div>

      <div class="values-grid">

        {
          merchValues.map((value) => (
            <article class="value-card">

              <span
                class="card-number"
                aria-hidden="true"
              >
                {value.number}
              </span>

              <h3>{value.title}</h3>

              <p>{value.description}</p>

            </article>
          ))
        }

      </div>

    </div>
  </section>


  <!-- ========================================
       SHOP THE COLLECTION
       ======================================== -->

  <section
    class="shop-section"
    aria-labelledby="shop-title"
  >
    <div class="page-container shop-grid">

      <!-- Shop Information -->

      <div class="shop-content">

        <p class="eyebrow">
          EXPLORE THE COLLECTION
        </p>

        <h2 id="shop-title">
          Find Your
          <span> Glow.</span>
        </h2>

        <p>
          Ready to explore the Clear & Glowing
          merchandise collection?
        </p>

        <p>
          Visit our official merchandise
          storefront to browse available
          items and find something that
          represents your connection to
          the community.
        </p>

        <div class="shop-actions">

          <Button
            href={links.merchandise}
            variant="primary"
          >
            Explore the Collection
            <span aria-hidden="true">↗</span>
          </Button>

        </div>

        <p class="shop-note">
          Product availability, pricing, checkout,
          shipping, and returns are handled through
          the external merchandise storefront.
          Please review its current details and
          policies before purchasing.
        </p>

      </div>

      <!-- Editorial Visual -->

      <div class="shop-visual">

        <div class="shop-visual-content">

          <p class="shop-visual-eyebrow">
            YOUR COMMUNITY. YOUR STYLE.
          </p>

          <p class="shop-visual-headline">
            GLOW
            <span>WITH US.</span>
          </p>

          <div class="shop-visual-footer">

            <p>
              CLEAR & GLOWING
            </p>

            <p>
              A student-founded community
              built on education, confidence,
              and connection.
            </p>

          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- ========================================
       COMMUNITY CTA
       ======================================== -->

  <section
    class="community-section"
    aria-labelledby="community-title"
  >
    <div class="page-container">

      <div class="community-content">

        <p class="community-eyebrow">
          BE PART OF SOMETHING BIGGER
        </p>

        <h2 id="community-title">
          Your Glow Has a Place Here.
        </h2>

        <p>
          Merchandise is just one way to
          celebrate Clear & Glowing.
        </p>

        <p>
          Discover our student community,
          learn about upcoming events,
          and explore opportunities to
          connect and make an impact.
        </p>

        <div class="community-actions">

          <Button
            href="/join"
            variant="primary"
          >
            Join Our Community
            <span aria-hidden="true">→</span>
          </Button>

          <Button
            href="/chapters"
            variant="outline-light"
          >
            Explore Our Chapters
          </Button>

        </div>

      </div>

    </div>
  </section>

</Layout>


<style>
  /* ========================================
     SHARED PAGE STYLES
     ======================================== */

  .page-container {
    width: min(
      calc(100% - 2rem),
      var(--max-content-width)
    );
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .section-heading h2 {
    margin: 0 0 1.5rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.85;
  }


  /* ========================================
     MERCH HERO
     ======================================== */

  .merch-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-content {
    max-width: 750px;
  }

  .hero-content h1 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .hero-content h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .store-note {
    margin: 1.75rem 0 0;
    color: #555555;
    font-size: 0.875rem;
    line-height: 1.7;
  }


  /* ========================================
     BRANDED HERO VISUAL
     ======================================== */

  .hero-visual {
    display: flex;
    min-width: 0;
    min-height: 480px;

    background: linear-gradient(
      145deg,
      #BB0000 0%,
      #850000 55%,
      #4B171C 100%
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .hero-visual-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;

    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);

    color: var(--color-white);
  }

  .visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .visual-message p {
    margin: 0;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .visual-message span {
    display: block;
    color: #F2D9D9;
  }

  .visual-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .visual-footer p:first-child {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .visual-footer p:last-child {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }


  /* ========================================
     MORE THAN MERCHANDISE
     ======================================== */

  .meaning-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .values-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;

    padding: clamp(1.75rem, 3vw, 2.5rem);

    background-color: var(--color-surface);
    border-top: 4px solid var(--color-primary);
    border-radius: 12px;
  }

  .card-number {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .value-card h3 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.3;
  }

  .value-card p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.85;
  }


  /* ========================================
     SHOP THE COLLECTION
     ======================================== */

  .shop-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .shop-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .shop-content h2 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .shop-content h2 span {
    color: var(--color-primary);
  }

  .shop-content > p:not(.eyebrow, .shop-note) {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    line-height: 1.85;
  }

  .shop-actions {
    margin-top: 2.5rem;
  }

  .shop-note {
    max-width: 650px;
    margin: 1.75rem 0 0;
    color: #555555;
    font-size: 0.875rem;
    line-height: 1.8;
  }


  /* ========================================
     SHOP VISUAL
     ======================================== */

  .shop-visual {
    display: flex;
    min-width: 0;
    min-height: 440px;

    background: linear-gradient(
      135deg,
      #BB0000 0%,
      #8A0000 55%,
      #4B171C 100%
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .shop-visual-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;

    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);

    color: var(--color-white);
  }

  .shop-visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .shop-visual-headline {
    margin: 0;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .shop-visual-headline span {
    display: block;
  }

  .shop-visual-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .shop-visual-footer p:first-child {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .shop-visual-footer p:last-child {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
  }


  /* ========================================
     COMMUNITY CTA
     ======================================== */

  .community-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: #23191C;
  }

  .community-content {
    display: flex;
    flex-direction: column;
    align-items: center;

    max-width: 850px;
    margin-inline: auto;

    text-align: center;
  }

  .community-eyebrow {
    margin: 0 0 1.25rem;
    color: #FFCECE;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .community-content h2 {
    margin: 0 0 2rem;
    color: var(--color-white);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .community-content > p:not(.community-eyebrow) {
    max-width: 650px;
    margin: 0 0 1.25rem;
    color: #E8E8E8;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .community-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }


  /* ========================================
     RESPONSIVE DESIGN
     ======================================== */

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(
        3,
        minmax(0, 1fr)
      );
    }
  }

  @media (min-width: 900px) {
    .hero-grid,
    .shop-grid {
      grid-template-columns:
        minmax(0, 1.15fr)
        minmax(0, 0.85fr);
    }
  }

  @media (max-width: 600px) {
    .hero-actions,
    .community-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-visual,
    .shop-visual {
      min-height: 350px;
    }

    .visual-message p,
    .shop-visual-headline {
      font-size: clamp(2.75rem, 10vw, 4rem);
    }
  }
</style>
