---
import Layout from '../layouts/Layout.astro';
import Hero from "../components/Hero.astro"
---

<Layout>
	<Hero />
</Layout>

<style>
	section {
		padding-block: 6rem
	}

	h1 {
		max-width: 850px;
		font-size: clamp(2.5rem, 6vw, 5rem);
	}

	p {
		max-width: 650px;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}
</style>
