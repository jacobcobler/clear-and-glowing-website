---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

import Hero from "../components/Hero.astro";
import Mission from "../components/Mission.astro";
import FourPillars from "../components/FourPillars.astro";
import FeaturedMoments from "../components/FeaturedMoments.astro";
import JoinCTA from "../components/JoinCTA.astro";
import PhotoShowcase from "../components/PhotoShowcase.astro";

import { photos, photoCollections } from "../data/photos";
---

<Layout
  description="Clear & Glowing is a student-founded community connecting skincare education, wellness, confidence, philanthropy, and beauty-industry opportunities."
>
  <!-- The existing Hero and Mission components already accept an image prop. -->
  <Hero image={photos.hero} />

  <Mission image={photos.mission} />

  <FourPillars />

  <!-- Verified as photographs from the supplied album; no specific event claims. -->
  <PhotoShowcase
    id="community-in-action"
    eyebrow="LIFE AT CLEAR & GLOWING"
    title="See Our Community in Action."
    description="A look at the conversations, shared experiences, and hands-on activities that bring people together."
    photos={photoCollections.homepage}
    background="white"
  />

  <section class="campus-section" aria-labelledby="campus-title">
    <div class="page-container campus-grid">
      <div class="campus-content">
        <p class="eyebrow">OUR CAMPUS NETWORK</p>

        <h2 id="campus-title">
          From One Campus to a
          <span> Growing Community.</span>
        </h2>

        <p>
          Founded at The Ohio State University in Fall 2024,
          Clear & Glowing began with a vision of making skincare
          education, confidence, and meaningful connections
          more accessible to students.
        </p>

        <p>
          We're building opportunities for student leaders at
          other universities to bring that mission to their own
          campuses. Through shared values, educational experiences,
          and community involvement, we hope to help more students
          find a place to learn, connect, and grow.
        </p>

        <div class="campus-actions">
          <Button href="/chapters" variant="primary">
            Explore Our Chapters
            <span aria-hidden="true">→</span>
          </Button>
          <Button href="/start-a-chapter" variant="outline">
            Start a Chapter
          </Button>
        </div>
      </div>

      <!-- Keep this informative founding-campus panel. It isn't a photo placeholder. -->
      <div class="campus-visual">
        <div class="campus-visual-content">
          <p class="campus-visual-label">WHERE IT ALL BEGAN</p>
          <p class="campus-visual-year">2024</p>
          <div class="campus-visual-details">
            <p class="campus-visual-university">The Ohio State University</p>
            <p class="campus-visual-location">Columbus, Ohio</p>
            <p class="campus-visual-note">One mission. More communities to reach.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FeaturedMoments />

  <JoinCTA />

  <section class="collaborate-section" aria-labelledby="collaborate-title">
    <div class="page-container">
      <div class="collaborate-content">
        <p class="collaborate-eyebrow">COLLABORATE WITH US</p>
        <h2 id="collaborate-title">Let's Make an Impact Together.</h2>
        <p>
          We welcome thoughtful collaborations with skincare brands,
          healthcare professionals, community organizations, and
          leaders who believe in education, access, and confidence.
        </p>
        <div class="collaborate-action">
          <Button href="/partners" variant="primary">
            Partner With Us
            <span aria-hidden="true">→</span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-container {
    width: min(calc(100% - 2rem), var(--max-content-width));
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .campus-section {
    width: 100%;
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .campus-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .campus-content {
    max-width: 650px;
  }

  .campus-content h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .campus-content h2 span { color: var(--color-primary); }

  .campus-content > p:not(.eyebrow) {
    margin: 1.5rem 0 0;
    color: var(--color-text);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.85;
  }

  .campus-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .campus-visual {
    display: flex;
    min-width: 0;
    min-height: 420px;
    background: linear-gradient(135deg, #BB0000 0%, #8A0000 55%, #4B171C 100%);
    border-radius: 12px;
    overflow: hidden;
  }

  .campus-visual-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .campus-visual-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.12em;
  }

  .campus-visual-year {
    margin: 0;
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .campus-visual-details {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .campus-visual-university {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .campus-visual-location {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .campus-visual-note {
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .collaborate-section {
    width: 100%;
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .collaborate-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 850px;
    margin-inline: auto;
    text-align: center;
  }

  .collaborate-eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.12em;
  }

  .collaborate-content h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .collaborate-content > p:not(.collaborate-eyebrow) {
    max-width: 680px;
    margin: 1.75rem 0 0;
    color: var(--color-text);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.85;
  }

  .collaborate-action { margin-top: 2.5rem; }

  @media (min-width: 900px) {
    .campus-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  @media (max-width: 600px) {
    .campus-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .campus-visual { min-height: 350px; }
  }
</style>
