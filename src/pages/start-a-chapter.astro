---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

import { links } from "../data/links";

const chapterBenefits = [
  {
    number: "01",
    title: "Build a Supportive Community",
    description:
      "Create an inclusive campus environment where students can connect, learn, and feel supported.",
  },
  {
    number: "02",
    title: "Develop Leadership Skills",
    description:
      "Gain experience in leadership, event planning, communications, outreach, and partnership development.",
  },
  {
    number: "03",
    title: "Host Educational Events",
    description:
      "Organize skincare education, wellness conversations, and other meaningful campus experiences.",
  },
  {
    number: "04",
    title: "Connect with Professionals",
    description:
      "Help introduce students to beauty-industry perspectives, career paths, and educational guest speakers.",
  },
  {
    number: "05",
    title: "Lead Community Initiatives",
    description:
      "Explore opportunities for volunteering, philanthropy, and student-led projects that serve your community.",
  },
  {
    number: "06",
    title: "Join a Growing Network",
    description:
      "Become part of a developing community of student leaders united by a shared mission.",
  },
];

const applicationSteps = [
  {
    number: "01",
    title: "Apply",
    description:
      "Tell us about yourself, your university, and why you want to bring Clear & Glowing to your campus.",
  },
  {
    number: "02",
    title: "Connect",
    description:
      "Our team reviews applications and follows up with next steps.",
  },
  {
    number: "03",
    title: "Build",
    description:
      "Approved leaders work on campus recognition, recruiting a board, and planning initial programming with support from the national team.",
  },
  {
    number: "04",
    title: "Launch",
    description:
      "Introduce Clear & Glowing to your campus and begin building your student community.",
  },
];
---

<Layout
  title="Start a Chapter"
  description="Bring Clear & Glowing to your university. Learn about starting a student-led chapter, developing leadership skills, building community, and applying through our official chapter application."
>

  <!-- ========================================
       PAGE HERO
       ======================================== -->

  <section
    class="chapter-hero"
    aria-labelledby="chapter-title"
  >
    <div class="page-container hero-grid">

      <div class="hero-content">
        <p class="eyebrow">
          START A CLEAR & GLOWING CHAPTER
        </p>

        <h1 id="chapter-title">
          Your Campus.
          <span>Your Community.</span>
          Your Glow.
        </h1>

        <p class="hero-description">
          Bring Clear & Glowing to your university
          and help create a space where students
          can learn about skincare, connect with
          professionals, build confidence, and
          serve their communities.
        </p>

        <p class="hero-description">
          Our chapters are student-led and united
          by a shared mission, while each campus
          can bring its own ideas and energy
          to the movement.
        </p>

        <div class="hero-actions">
          <Button
            href={links.chapterApplication}
            variant="primary"
          >
            Apply to Start a Chapter
            <span aria-hidden="true">↗</span>
          </Button>

          <Button
            href="#how-it-works"
            variant="outline"
          >
            See How It Works
          </Button>
        </div>
      </div>

      <!-- Branded visual highlighting the founding campus -->

      <div class="hero-visual">
        <div class="hero-visual-content">

          <p class="visual-eyebrow">
            ONE MISSION. MORE COMMUNITIES.
          </p>

          <p class="visual-headline">
            Bring the
            <span>Glow to</span>
            Your Campus.
          </p>

          <div class="visual-footer">
            <p>Clear & Glowing</p>

            <p>
              Founded at The Ohio State University
              in Fall 2024.
            </p>
          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- ========================================
       WHY START A CHAPTER
       ======================================== -->

  <section
    class="benefits-section"
    aria-labelledby="benefits-title"
  >
    <div class="page-container">

      <div class="section-heading">
        <p class="eyebrow">
          WHY START A CHAPTER?
        </p>

        <h2 id="benefits-title">
          Make Your Campus a Place to Glow.
        </h2>

        <p>
          Starting a chapter is an opportunity
          to bring people together, develop practical
          skills, and create experiences that reflect
          the needs and interests of your campus.
        </p>
      </div>

      <div class="benefits-grid">
        {
          chapterBenefits.map((benefit) => (
            <article class="benefit-card">

              <span
                class="card-number"
                aria-hidden="true"
              >
                {benefit.number}
              </span>

              <h3>{benefit.title}</h3>

              <p>{benefit.description}</p>

            </article>
          ))
        }
      </div>

    </div>
  </section>


  <!-- ========================================
       HOW IT WORKS
       ======================================== -->

  <section
    class="process-section"
    id="how-it-works"
    aria-labelledby="process-title"
  >
    <div class="page-container">

      <div class="section-heading">
        <p class="eyebrow">
          THE APPLICATION PROCESS
        </p>

        <h2 id="process-title">
          How It Works
        </h2>

        <p>
          From expressing your interest to building
          a student community, here's how the
          chapter development process is structured.
        </p>
      </div>

      <ol class="process-list">
        {
          applicationSteps.map((step) => (
            <li class="process-step">

              <span
                class="step-number"
                aria-hidden="true"
              >
                {step.number}
              </span>

              <div class="step-content">
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>

            </li>
          ))
        }
      </ol>

      <p class="process-note">
        Chapter applications are reviewed by the
        Clear & Glowing team. Submitting an
        application does not guarantee approval
        or a particular launch date.
      </p>

    </div>
  </section>


  <!-- ========================================
       OUR CHAPTER VISION
       ======================================== -->

  <section
    class="vision-section"
    aria-labelledby="vision-title"
  >
    <div class="page-container vision-grid">

      <div class="vision-content">

        <p class="eyebrow">
          A SHARED MISSION
        </p>

        <h2 id="vision-title">
          One Mission.
          <span>Your Unique Community.</span>
        </h2>

        <p>
          Every university has its own people,
          interests, and opportunities.
        </p>

        <p>
          Clear & Glowing chapters share
          a commitment to skincare education,
          wellness, confidence, service,
          and access to the beauty industry.
          At the same time, student leaders
          help shape experiences that are
          meaningful to their campus.
        </p>

        <p>
          What began at Ohio State in Fall 2024
          is developing into a wider community
          where more students can lead,
          learn, and make an impact.
        </p>

        <div class="vision-action">
          <Button
            href="/chapters"
            variant="outline"
          >
            Explore Our Chapters
            <span aria-hidden="true">→</span>
          </Button>
        </div>

      </div>

      <div class="vision-visual">
        <div class="vision-visual-content">

          <p class="vision-visual-eyebrow">
            BUILD SOMETHING MEANINGFUL
          </p>

          <p class="vision-visual-headline">
            LEAD.
            <span>CONNECT.</span>
            GLOW.
          </p>

          <div class="vision-visual-footer">
            <p>
              Your campus could be part
              of the next chapter.
            </p>
          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- ========================================
       FINAL APPLICATION CTA
       ======================================== -->

  <section
    class="apply-section"
    aria-labelledby="apply-title"
  >
    <div class="page-container">

      <div class="apply-content">

        <p class="apply-eyebrow">
          READY TO GET STARTED?
        </p>

        <h2 id="apply-title">
          The Next Chapter Could Start With You.
        </h2>

        <p>
          Interested in creating a Clear & Glowing
          community at your university?
          Tell us about yourself, your campus,
          and your vision.
        </p>

        <p>
          Take the first step by completing
          our official university chapter application.
        </p>

        <div class="apply-actions">

          <Button
            href={links.chapterApplication}
            variant="primary"
          >
            Apply to Start a Chapter
            <span aria-hidden="true">↗</span>
          </Button>

          <Button
            href="/join"
            variant="outline-light"
          >
            Join Our Community
          </Button>

        </div>

        <p class="apply-note">
          Applications are submitted through
          the official Clear & Glowing Google Form.
        </p>

      </div>

    </div>
  </section>

</Layout>


<style>
  /* ========================================
     SHARED PAGE STYLES
     ======================================== */

  .page-container {
    width: min(
      calc(100% - 2rem),
      var(--max-content-width)
    );
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .section-heading h2 {
    margin: 0 0 1.5rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  #how-it-works {
    scroll-margin-top: 6rem;
  }


  /* ========================================
     HERO SECTION
     ======================================== */

  .chapter-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-content {
    max-width: 760px;
  }

  .hero-content h1 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .hero-content h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }


  /* ========================================
     HERO VISUAL
     ======================================== */

  .hero-visual {
    display: flex;
    min-width: 0;
    min-height: 460px;

    background: linear-gradient(
      145deg,
      #BB0000 0%,
      #850000 55%,
      #4B171C 100%
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .hero-visual-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;

    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .visual-headline {
    margin: 0;
    font-size: clamp(2.75rem, 4.5vw, 4.75rem);
    font-weight: 800;
    line-height: 1.07;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .visual-headline span {
    display: block;
  }

  .visual-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .visual-footer p:first-child {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .visual-footer p:last-child {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }


  /* ========================================
     WHY START A CHAPTER
     ======================================== */

  .benefits-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .benefit-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;

    padding: clamp(1.75rem, 3vw, 2.5rem);

    background-color: var(--color-surface);
    border-top: 4px solid var(--color-primary);
    border-radius: 12px;
  }

  .card-number {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .benefit-card h3 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.3;
  }

  .benefit-card p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.85;
  }


  /* ========================================
     APPLICATION PROCESS
     ======================================== */

  .process-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .process-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;

    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;

    min-width: 0;
    padding: clamp(1.75rem, 3vw, 2.5rem);

    background-color: var(--color-white);
    border: 1px solid #E5E5E5;
    border-radius: 12px;
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 60px;
    height: 60px;
    flex-shrink: 0;

    background-color: var(--color-primary);
    color: var(--color-white);
    border-radius: 50%;

    font-size: 1.1rem;
    font-weight: 800;
  }

  .step-content h3 {
    margin: 0 0 1rem;
    color: var(--color-heading);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .step-content p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.85;
  }

  .process-note {
    max-width: 820px;
    margin: 2rem 0 0;
    color: #555555;
    font-size: 0.9rem;
    line-height: 1.8;
  }


  /* ========================================
     CHAPTER VISION
     ======================================== */

  .vision-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .vision-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .vision-content h2 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .vision-content h2 span {
    display: block;
    color: var(--color-primary);
  }

  .vision-content > p:not(.eyebrow) {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    line-height: 1.85;
  }

  .vision-action {
    margin-top: 2.5rem;
  }

  .vision-visual {
    display: flex;
    min-width: 0;
    min-height: 430px;

    background: linear-gradient(
      135deg,
      #BB0000,
      #8A0000 55%,
      #4B171C
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .vision-visual-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;

    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .vision-visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .vision-visual-headline {
    margin: 0;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .vision-visual-headline span {
    display: block;
  }

  .vision-visual-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .vision-visual-footer p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
  }


  /* ========================================
     FINAL APPLICATION CTA
     ======================================== */

  .apply-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: #23191C;
  }

  .apply-content {
    display: flex;
    flex-direction: column;
    align-items: center;

    max-width: 850px;
    margin-inline: auto;
    text-align: center;
  }

  .apply-eyebrow {
    margin: 0 0 1.25rem;
    color: #FFCECE;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .apply-content h2 {
    margin: 0 0 2rem;
    color: var(--color-white);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .apply-content > p:not(.apply-eyebrow, .apply-note) {
    max-width: 650px;
    margin: 0 0 1.25rem;
    color: #E8E8E8;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .apply-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .apply-note {
    margin: 1.5rem 0 0;
    color: #D0D0D0;
    font-size: 0.85rem;
    line-height: 1.7;
  }


  /* ========================================
     RESPONSIVE DESIGN
     ======================================== */

  @media (min-width: 640px) {
    .benefits-grid {
      grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
      );
    }

    .process-list {
      grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
      );
    }
  }

  @media (min-width: 900px) {
    .hero-grid,
    .vision-grid {
      grid-template-columns:
        minmax(0, 1.15fr)
        minmax(0, 0.85fr);
    }

    .benefits-grid {
      grid-template-columns: repeat(
        3,
        minmax(0, 1fr)
      );
    }
  }

  @media (max-width: 600px) {
    .hero-actions,
    .apply-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-visual,
    .vision-visual {
      min-height: 350px;
    }

    .visual-headline,
    .vision-visual-headline {
      font-size: clamp(2.5rem, 9vw, 4rem);
    }
  }
</style>
