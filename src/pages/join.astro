---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

import { links } from "../data/links";

const reasons = [
  {
    number: "01",
    title: "Learn Something New",
    description:
      "Explore skincare education, wellness, and beauty-industry perspectives through community experiences and educational programming.",
  },
  {
    number: "02",
    title: "Find Your Community",
    description:
      "Connect with students who share your interests, support one another, and believe that confidence goes beyond appearance.",
  },
  {
    number: "03",
    title: "Make a Difference",
    description:
      "Discover opportunities to develop as a leader, participate in community initiatives, and help bring meaningful ideas to life.",
  },
];
---

<Layout title="Join Us"
  description="Join the Clear & Glowing community to explore skincare education, wellness, student leadership, beauty-industry opportunities, and meaningful community connections."
>

  <!-- ========================================
       JOIN HERO
       ======================================== -->

  <section
    class="join-hero"
    aria-labelledby="join-title"
  >
    <div class="page-container">
      <div class="hero-content">

        <p class="eyebrow">
          JOIN CLEAR & GLOWING
        </p>

        <h1 id="join-title">
          Find Your People.
          <span>Find Your Glow.</span>
        </h1>

        <p class="hero-description">
          Clear & Glowing brings together students
          who care about skincare, wellness, leadership,
          beauty, and making a difference.
        </p>

        <p class="hero-description">
          You don't need to be a skincare expert
          to belong. Whether you want to attend
          events, learn something new, volunteer,
          or connect with others, we'd love to
          keep you in the loop.
        </p>

        <div class="hero-actions">

          <Button
            href={links.newsletter}
            variant="primary"
          >
            Join Our Newsletter
            <span aria-hidden="true">→</span>
          </Button>

          <Button
            href="#why-join"
            variant="outline"
          >
            Discover the Community
          </Button>

        </div>

      </div>
    </div>
  </section>


  <!-- ========================================
       WHY JOIN?
       ======================================== -->

  <section
    class="reasons-section"
    id="why-join"
    aria-labelledby="reasons-title"
  >
    <div class="page-container">

      <div class="section-heading">

        <p class="eyebrow">
          MORE THAN A CLUB
        </p>

        <h2 id="reasons-title">
          There's a Place for You Here.
        </h2>

        <p>
          Whether you're passionate about skincare,
          interested in the beauty industry, or simply
          looking for a welcoming community, Clear &
          Glowing offers opportunities to learn,
          connect, and get involved.
        </p>

      </div>

      <div class="reasons-grid">
        {
          reasons.map((reason) => (
            <article class="reason-card">

              <span
                class="card-number"
                aria-hidden="true"
              >
                {reason.number}
              </span>

              <h3>{reason.title}</h3>

              <p>{reason.description}</p>

            </article>
          ))
        }
      </div>

    </div>
  </section>


  <!-- ========================================
       NEWSLETTER SIGNUP
       ======================================== -->

  <section
    class="newsletter-section"
    aria-labelledby="newsletter-title"
  >
    <div class="page-container">

      <div class="newsletter-panel">
        <div class="newsletter-content">

          <p class="newsletter-eyebrow">
            STAY CONNECTED
          </p>

          <h2 id="newsletter-title">
            Stay in the Know.
          </h2>

          <p class="newsletter-description">
            Get updates on events, chapter launches,
            opportunities, collaborations, and ways
            to get involved with Clear & Glowing.
          </p>

          <p class="newsletter-description">
            Whether you're just discovering us or
            already part of the community, our
            newsletter is a great way to stay connected.
          </p>

          <div class="newsletter-action">

            <Button
              href={links.newsletter}
              variant="primary"
            >
              Sign Up for Our Newsletter
              <span aria-hidden="true">→</span>
            </Button>

          </div>

          <p class="newsletter-note">
            Newsletter signup opens our official
            Google Form.
          </p>

        </div>
      </div>

    </div>
  </section>


  <!-- ========================================
       START A CHAPTER
       ======================================== -->

  <section
    class="chapter-section"
    aria-labelledby="chapter-title"
  >
    <div class="page-container chapter-grid">

      <div class="chapter-content">

        <p class="eyebrow">
          BRING THE GLOW TO YOUR CAMPUS
        </p>

        <h2 id="chapter-title">
          Your Campus.
          <span>Your Community.</span>
        </h2>

        <p>
          Want to bring Clear & Glowing to your
          university? Starting a chapter is an
          opportunity to create a space where
          students can learn about skincare,
          build confidence, connect with
          professionals, and serve their community.
        </p>

        <p>
          Each chapter is student-led and guided
          by the same shared mission, while
          bringing its own ideas, energy, and
          experiences to campus.
        </p>

        <div class="chapter-actions">

          <Button
            href={links.chapterApplication}
            variant="primary"
          >
            Apply to Start a Chapter
            <span aria-hidden="true">→</span>
          </Button>

          <Button
            href="/chapters"
            variant="outline"
          >
            Explore Our Chapters
          </Button>

        </div>

      </div>

      <!-- Branded Campus Visual -->

      <div class="chapter-visual">
        <div class="chapter-visual-content">

          <p class="visual-eyebrow">
            ONE MISSION. MORE COMMUNITIES.
          </p>

          <div class="visual-message">
            <p>
              The Next Chapter
              <span>Could Start With You.</span>
            </p>
          </div>

          <div class="visual-footer">
            <p>
              Clear & Glowing
            </p>

            <p>
              Founded at The Ohio State University
              in Fall 2024
            </p>
          </div>

        </div>
      </div>

    </div>
  </section>

</Layout>


<style>
  /* ========================================
     SHARED PAGE STYLES
     ======================================== */

  .page-container {
    width: min(
      calc(100% - 2rem),
      var(--max-content-width)
    );
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .section-heading h2 {
    margin: 0 0 1.5rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.85;
  }


  /* ========================================
     JOIN HERO
     ======================================== */

  .join-hero {
    padding-block: clamp(5rem, 9vw, 8rem);
    background-color: var(--color-surface);
  }

  .hero-content {
    max-width: 900px;
  }

  .hero-content h1 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .hero-content h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    max-width: 760px;
    margin: 0 0 1.25rem;
    color: var(--color-text);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }


  /* ========================================
     WHY JOIN
     ======================================== */

  .reasons-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .reasons-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .reason-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;

    padding: clamp(1.75rem, 3vw, 2.5rem);

    background-color: var(--color-surface);
    border-top: 4px solid var(--color-primary);
    border-radius: 12px;
  }

  .card-number {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .reason-card h3 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    line-height: 1.3;
  }

  .reason-card p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.85;
  }


  /* ========================================
     NEWSLETTER
     ======================================== */

  .newsletter-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .newsletter-panel {
    padding: clamp(2.5rem, 6vw, 5rem);

    background: linear-gradient(
      135deg,
      #4B171C,
      #23191C 60%,
      #111111
    );

    border-radius: 16px;
  }

  .newsletter-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
  }

  .newsletter-eyebrow {
    margin: 0 0 1.25rem;
    color: #FFCECE;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .newsletter-content h2 {
    margin: 0 0 2rem;
    color: var(--color-white);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .newsletter-description {
    max-width: 650px;
    margin: 0 0 1.25rem;
    color: #E8E8E8;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .newsletter-action {
    margin-top: 2rem;
  }

  .newsletter-note {
    margin: 1.5rem 0 0;
    color: #D0D0D0;
    font-size: 0.85rem;
    line-height: 1.7;
  }


  /* ========================================
     START A CHAPTER
     ======================================== */

  .chapter-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .chapter-content h2 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .chapter-content h2 span {
    display: block;
    color: var(--color-primary);
  }

  .chapter-content > p:not(.eyebrow) {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    line-height: 1.85;
  }

  .chapter-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }


  /* ========================================
     BRANDED CAMPUS VISUAL
     ======================================== */

  .chapter-visual {
    display: flex;
    min-width: 0;
    min-height: 460px;

    background: linear-gradient(
      135deg,
      #BB0000 0%,
      #8A0000 55%,
      #4B171C 100%
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .chapter-visual-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .visual-message p {
    margin: 0;
    font-size: clamp(2.5rem, 4vw, 4.25rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .visual-message span {
    display: block;
  }

  .visual-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .visual-footer p:first-child {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .visual-footer p:last-child {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }


  /* ========================================
     RESPONSIVE DESIGN
     ======================================== */

  @media (min-width: 768px) {
    .reasons-grid {
      grid-template-columns: repeat(
        3,
        minmax(0, 1fr)
      );
    }
  }

  @media (min-width: 900px) {
    .chapter-grid {
      grid-template-columns:
        minmax(0, 1.15fr)
        minmax(0, 0.85fr);
    }
  }

  @media (max-width: 600px) {
    .hero-actions,
    .chapter-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .newsletter-panel {
      padding: 2.5rem 1.5rem;
    }

    .chapter-visual {
      min-height: 380px;
    }
  }
</style>
