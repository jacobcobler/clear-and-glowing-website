---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

import { links } from "../data/links";
import PhotoShowcase from "../components/PhotoShowcase.astro";
import { photos, photoCollections } from "../data/photos";

// Keep the hero photograph out of the additional photo gallery.
const opportunityGallery = photoCollections.opportunities.filter(
  (photo) => photo.src !== photos.careerSpeaker.src
);

const careerFields = [
  "Science",
  "Marketing",
  "Finance",
  "Innovation",
  "Entrepreneurship",
  "Design",
  "Education",
];

const opportunities = [
  {
    number: "01",
    title: "Industry Conversations & Guest Speakers",
    description:
      "Explore different areas of the beauty and skincare industry through conversations with professionals, educators, and guest speakers.",
    future: false,
  },
  {
    number: "02",
    title: "Mentorship & Professional Networking",
    description:
      "Discover opportunities to connect with professionals, hear their experiences, and learn about potential career pathways.",
    future: false,
  },
  {
    number: "03",
    title: "Internship & Career Resources",
    description:
      "Learn about career paths, professional development, and resources that can help you navigate opportunities in the beauty industry.",
    future: false,
  },
  {
    number: "04",
    title: "Student Leadership & Chapter Roles",
    description:
      "Build leadership, communication, event-planning, and organizational skills through student-led chapter activities.",
    future: false,
  },
  {
    number: "05",
    title: "Volunteering & Community Initiatives",
    description:
      "Connect your interests to meaningful service through community outreach, educational activities, and student-led initiatives.",
    future: false,
  },
  {
    number: "06",
    title: "Future Fellowships & National Programs",
    description:
      "As Clear & Glowing grows, we hope to develop additional programs that support leadership, education, and professional growth.",
    future: true,
  },
];
---

<Layout
  title="Opportunities"
  description="Discover career exploration, industry conversations, student leadership, volunteer initiatives, and future opportunities with Clear & Glowing."
>

  <!-- ========================================
       OPPORTUNITIES HERO
       ======================================== -->

  <section
    class="opportunities-hero"
    aria-labelledby="opportunities-title"
  >
    <div class="page-container hero-grid">

      <div class="hero-content">

        <p class="eyebrow">
          OPPORTUNITIES WITH CLEAR & GLOWING
        </p>

        <h1 id="opportunities-title">
          Your Passion for Beauty
          <span>Can Become Your Career.</span>
        </h1>

        <p class="hero-description">
          The beauty industry is bigger than products
          on a shelf. It includes science, marketing,
          finance, innovation, entrepreneurship,
          design, education, and so much more.
        </p>

        <p class="hero-description">
          Clear & Glowing creates opportunities for
          students to discover these paths and connect
          with people who can help them explore
          what comes next.
        </p>

        <div class="hero-actions">

          <Button
            href="#explore-opportunities"
            variant="primary"
          >
            Explore Opportunities
            <span aria-hidden="true">→</span>
          </Button>

          <Button
            href={links.newsletter}
            variant="outline"
          >
            Get Opportunity Updates
          </Button>

        </div>

      </div>

      <!-- Branded Career Visual -->

      <div class="hero-visual">

        <img
          class="visual-photo"
          src={photos.careerSpeaker.src}
          alt={photos.careerSpeaker.alt}
          width={photos.careerSpeaker.width}
          height={photos.careerSpeaker.height}
          loading="lazy"
          decoding="async"
        />

        <div class="hero-visual-content">

          <p class="visual-eyebrow">
            BEYOND THE BEAUTY COUNTER
          </p>

          <p class="visual-headline">
            Your Interests.
            <span>New Possibilities.</span>
          </p>

          <div class="visual-fields">
            <p>
              Discover the many disciplines
              that help shape the beauty industry.
            </p>

            <ul class="field-list">
              {
                careerFields.map((field) => (
                  <li>{field}</li>
                ))
              }
            </ul>
          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- ========================================
       OPPORTUNITY CATEGORIES
       ======================================== -->

  <section
    class="opportunities-section"
    id="explore-opportunities"
    aria-labelledby="explore-title"
  >
    <div class="page-container">

      <div class="section-heading">

        <p class="eyebrow">
          EXPLORE THE POSSIBILITIES
        </p>

        <h2 id="explore-title">
          Discover Where Your Interests Can Take You.
        </h2>

        <p>
          From career exploration to community
          service, Clear & Glowing brings together
          different ways for students to learn,
          connect, and grow.
        </p>

      </div>

      <div class="opportunities-grid">
        {
          opportunities.map((opportunity) => (
            <article class="opportunity-card">

              <div class="card-top">
                <span
                  class="card-number"
                  aria-hidden="true"
                >
                  {opportunity.number}
                </span>

                {
                  opportunity.future && (
                    <span class="future-label">
                      FUTURE PROGRAM
                    </span>
                  )
                }
              </div>

              <h3>{opportunity.title}</h3>

              <p>{opportunity.description}</p>

            </article>
          ))
        }
      </div>

      <p class="availability-note">
        These categories describe areas of interest and
        programming, not a list of currently open positions.
        Specific internships, mentorship placements, and
        fellowships are not being advertised here.
      </p>

    </div>
  </section>


  <!-- ========================================
       STUDENT LEADERSHIP
       ======================================== -->

  <section
    class="leadership-section"
    aria-labelledby="leadership-title"
  >
    <div class="page-container leadership-grid">

      <div class="leadership-content">

        <p class="eyebrow">
          LEADERSHIP STARTS HERE
        </p>

        <h2 id="leadership-title">
          Grow as a Leader.
          <span>Make an Impact.</span>
        </h2>

        <p>
          Developing as a leader doesn't have to
          wait until after graduation.
        </p>

        <p>
          Through campus chapters, students can
          help organize events, build community,
          connect with professionals, and support
          initiatives that make a difference.
        </p>

        <p>
          Whether you're interested in event
          planning, outreach, communications,
          or bringing students together around
          a shared mission, chapter involvement
          is one way to develop practical skills.
        </p>

        <div class="leadership-actions">

          <Button
            href="/chapters"
            variant="primary"
          >
            Explore Our Chapters
            <span aria-hidden="true">→</span>
          </Button>

          <Button
            href={links.chapterApplication}
            variant="outline"
          >
            Apply to Start a Chapter
          </Button>

        </div>

      </div>

      <!-- Leadership Visual -->

      <div class="leadership-visual">

        <img
          class="visual-photo"
          src={photos.campusGroup.src}
          alt={photos.campusGroup.alt}
          width={photos.campusGroup.width}
          height={photos.campusGroup.height}
          loading="lazy"
          decoding="async"
        />

        <div class="leadership-visual-content">

          <p class="leadership-visual-eyebrow">
            YOUR NEXT STEP
          </p>

          <p class="leadership-visual-headline">
            Lead.
            <span>Connect.</span>
            Create.
          </p>

          <div class="leadership-visual-footer">
            <p>
              Build skills while building community.
            </p>

            <p>
              Clear & Glowing
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>


  <PhotoShowcase
    id="opportunities-gallery"
    eyebrow="LEARNING TOGETHER"
    title="Conversations That Open Doors"
    description="Glimpses of presentations, group discussions, and student experiences."
    photos={opportunityGallery}
    background="white"
  />

  <!-- ========================================
       OPPORTUNITY NEWSLETTER CTA
       ======================================== -->

  <section
    class="updates-section"
    aria-labelledby="updates-title"
  >
    <div class="page-container">

      <div class="updates-content">

        <p class="updates-eyebrow">
          STAY IN THE LOOP
        </p>

        <h2 id="updates-title">
          Your Next Opportunity Starts With Staying Connected.
        </h2>

        <p>
          Interested in upcoming events, industry
          conversations, chapter activities, or
          future programs?
        </p>

        <p>
          Join our newsletter to hear about
          opportunities as they're announced
          and discover new ways to get involved.
        </p>

        <div class="updates-action">

          <Button
            href={links.newsletter}
            variant="primary"
          >
            Hear About New Opportunities
            <span aria-hidden="true">→</span>
          </Button>

        </div>

        <p class="updates-note">
          Signup opens the official Clear & Glowing
          newsletter Google Form.
        </p>

      </div>

    </div>
  </section>

</Layout>


<style>
  /* ========================================
     SHARED PAGE STYLES
     ======================================== */

  .page-container {
    width: min(
      calc(100% - 2rem),
      var(--max-content-width)
    );
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .section-heading h2 {
    margin: 0 0 1.5rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.85;
  }


  /* ========================================
     OPPORTUNITIES HERO
     ======================================== */

  .opportunities-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-content {
    max-width: 760px;
  }

  .hero-content h1 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .hero-content h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }


  /* ========================================
     BRANDED HERO VISUAL
     ======================================== */

  .hero-visual {
    min-width: 0;
    min-height: 440px;
    display: flex;

    background: linear-gradient(
      145deg,
      #BB0000,
      #850000 55%,
      #4B171C
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .hero-visual-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;

    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .visual-headline {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3.25rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .visual-headline span {
    display: block;
  }

  .visual-fields {
    border-top: 1px solid rgb(255 255 255 / 0.5);
    padding-top: 1.5rem;
  }

  .visual-fields > p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .field-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .field-list li {
    padding: 0.4rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }


  /* ========================================
     PHOTOGRAPHIC VISUAL PANELS
     ======================================== */

  .hero-visual,
  .leadership-visual {
    position: relative;
    isolation: isolate;
  }

  .visual-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-visual::before,
  .leadership-visual::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgb(18 12 16 / 0.90) 0%,
      rgb(18 12 16 / 0.76) 100%
    );
    pointer-events: none;
  }

  .hero-visual-content,
  .leadership-visual-content {
    position: relative;
    z-index: 2;
  }

  /* ========================================
     OPPORTUNITY CATEGORIES
     ======================================== */

  .opportunities-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .opportunities-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .opportunity-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;

    padding: clamp(1.75rem, 3vw, 2.5rem);

    background-color: var(--color-surface);
    border-top: 4px solid var(--color-primary);
    border-radius: 12px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    width: 100%;
  }

  .card-number {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .future-label {
    padding: 0.35rem 0.65rem;
    background-color: #E8E1E1;
    color: #4B171C;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .opportunity-card h3 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.3;
  }

  .opportunity-card p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.85;
  }

  .availability-note {
    max-width: 800px;
    margin: 2rem 0 0;
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.8;
  }


  /* ========================================
     STUDENT LEADERSHIP
     ======================================== */

  .leadership-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .leadership-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .leadership-content h2 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .leadership-content h2 span {
    display: block;
    color: var(--color-primary);
  }

  .leadership-content > p:not(.eyebrow) {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    line-height: 1.85;
  }

  .leadership-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }


  /* ========================================
     LEADERSHIP VISUAL
     ======================================== */

  .leadership-visual {
    display: flex;
    min-width: 0;
    min-height: 440px;

    background: linear-gradient(
      135deg,
      #BB0000 0%,
      #8A0000 55%,
      #4B171C 100%
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .leadership-visual-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;

    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .leadership-visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .leadership-visual-headline {
    margin: 0;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .leadership-visual-headline span {
    display: block;
  }

  .leadership-visual-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .leadership-visual-footer p:first-child {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .leadership-visual-footer p:last-child {
    margin: 0;
    font-size: 0.9rem;
  }


  /* ========================================
     OPPORTUNITY UPDATES CTA
     ======================================== */

  .updates-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: #23191C;
  }

  .updates-content {
    display: flex;
    flex-direction: column;
    align-items: center;

    max-width: 850px;
    margin-inline: auto;
    text-align: center;
  }

  .updates-eyebrow {
    margin: 0 0 1.25rem;
    color: #FFCECE;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .updates-content h2 {
    margin: 0 0 2rem;
    color: var(--color-white);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .updates-content > p:not(.updates-eyebrow, .updates-note) {
    max-width: 650px;
    margin: 0 0 1.25rem;
    color: #E8E8E8;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .updates-action {
    margin-top: 2rem;
  }

  .updates-note {
    margin: 1.5rem 0 0;
    color: #D0D0D0;
    font-size: 0.85rem;
    line-height: 1.7;
  }


  /* ========================================
     RESPONSIVE DESIGN
     ======================================== */

  @media (min-width: 768px) {
    .opportunities-grid {
      grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
      );
    }
  }

  @media (min-width: 900px) {
    .hero-grid,
    .leadership-grid {
      grid-template-columns:
        minmax(0, 1.15fr)
        minmax(0, 0.85fr);
    }
  }

  @media (max-width: 600px) {
    .hero-actions,
    .leadership-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-visual,
    .leadership-visual {
      min-height: 360px;
    }

    .visual-headline {
      font-size: 2.25rem;
    }
  }
</style>
