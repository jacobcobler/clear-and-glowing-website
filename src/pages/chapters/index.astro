---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import ChapterCard from "../../components/ChapterCard.astro";
import PhotoShowcase from "../../components/PhotoShowcase.astro";

import { chapters } from "../../data/chapters";
import { links } from "../../data/links";
import { photos, photoCollections } from "../../data/photos";

// Display only chapters approved for publication.
// Chapters can remain in chapters.ts while their
// information and status are being verified.
const approvedChapters = chapters.filter(
  (chapter) => chapter.approved
);

const chapterExperiences = [
  {
    number: "01",
    title: "Skincare Education",
    description:
      "Learn through skincare conversations, educational events, guest speakers, and perspectives from industry professionals.",
  },
  {
    number: "02",
    title: "Community & Confidence",
    description:
      "Build meaningful friendships and create welcoming spaces where students feel supported, included, and empowered.",
  },
  {
    number: "03",
    title: "Philanthropy & Service",
    description:
      "Turn care into action through volunteer opportunities, community outreach, and student-led service initiatives.",
  },
  {
    number: "04",
    title: "Beauty Industry Access",
    description:
      "Explore career paths, networking opportunities, mentorship, and professional experiences across beauty and wellness.",
  },
];
---

<Layout
  title="Our Chapters"
  description="Explore Clear & Glowing university chapters, discover student-led communities, and learn how to bring Clear & Glowing to your campus."
>

  <!-- ========================================
       CHAPTERS HERO
       ======================================== -->

  <section
    class="chapters-hero"
    aria-labelledby="chapters-title"
  >
    <div class="page-container hero-grid">

      <div class="hero-content">

        <p class="eyebrow">
          OUR UNIVERSITY CHAPTERS
        </p>

        <h1 id="chapters-title">
          From One Campus
          <span>to a Growing Community.</span>
        </h1>

        <p class="hero-description">
          Founded at The Ohio State University
          in Fall 2024, Clear & Glowing is
          working to bring skincare education,
          confidence, wellness, and community
          service to more university campuses.
        </p>

        <p class="hero-description">
          Every chapter shares our mission
          while giving student leaders the
          opportunity to build a community
          that reflects their own campus.
        </p>

        <div class="hero-actions">

          <Button
            href="#chapter-directory"
            variant="primary"
          >
            Explore Our Chapters
            <span aria-hidden="true">→</span>
          </Button>

          <Button
            href="/start-a-chapter"
            variant="outline"
          >
            Start a Chapter
          </Button>

        </div>

      </div>

      <div class="hero-visual">

        <!-- General student community photo; not presented as a specific campus chapter. -->
        <img
          class="hero-photo"
          src={photos.chapters.src}
          alt={photos.chapters.alt}
          width={photos.chapters.width}
          height={photos.chapters.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <div class="hero-visual-content">

          <p class="visual-eyebrow">
            THE CLEAR & GLOWING COMMUNITY
          </p>

          <p class="visual-headline">
            ONE
            <span>SHARED</span>
            MISSION.
          </p>

          <div class="visual-footer">

            <p>
              Every community starts somewhere.
            </p>

            <p>
              Ours began at The Ohio State University.
            </p>

          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- ========================================
       CHAPTER DIRECTORY
       ======================================== -->

  <section
    class="directory-section"
    id="chapter-directory"
    aria-labelledby="directory-title"
  >
    <div class="page-container">

      <div class="section-heading">

        <p class="eyebrow">
          EXPLORE THE NETWORK
        </p>

        <h2 id="directory-title">
          Our University Chapters.
        </h2>

        <p>
          Discover the student-led communities
          bringing Clear & Glowing's mission
          to life.
        </p>

      </div>

      <!-- Uses the existing chapters.ts data
           and reusable ChapterCard component. -->

      {
        approvedChapters.length > 0 ? (
          <div class="chapter-grid">

            {
              approvedChapters.map((chapter) => (
                <ChapterCard chapter={chapter} />
              ))
            }

          </div>
        ) : (
          <div class="empty-state">

            <h3>
              Chapter Information Coming Soon.
            </h3>

            <p>
              We're preparing our university
              chapter directory. Check back
              for confirmed chapter information.
            </p>

          </div>
        )
      }

      <div class="directory-note">

        <h3>
          More Communities, One Mission.
        </h3>

        <p>
          We're continuing to develop
          opportunities for students to
          establish Clear & Glowing
          chapters at their universities.
        </p>

        <p>
          New chapters will be added to
          this directory as their
          information and status
          are verified.
        </p>

        <a href="/start-a-chapter">
          Interested in starting a chapter?
          <span aria-hidden="true">→</span>
        </a>

      </div>

    </div>
  </section>


  <!-- ========================================
       CHAPTER EXPERIENCES
       ======================================== -->

  <section
    class="experiences-section"
    aria-labelledby="experiences-title"
  >
    <div class="page-container">

      <div class="section-heading">

        <p class="eyebrow">
          LIFE IN A CHAPTER
        </p>

        <h2 id="experiences-title">
          More Than a Campus Organization.
        </h2>

        <p>
          Clear & Glowing brings students
          together through four areas of
          focus that encourage learning,
          leadership, community,
          and meaningful impact.
        </p>

      </div>

      <div class="experiences-grid">

        {
          chapterExperiences.map((experience) => (
            <article class="experience-card">

              <span
                class="experience-number"
                aria-hidden="true"
              >
                {experience.number}
              </span>

              <h3>{experience.title}</h3>

              <p>{experience.description}</p>

            </article>
          ))
        }

      </div>

    </div>
  </section>


  <!-- Community photographs are editorial images, not evidence of chapter status. -->
  <PhotoShowcase
    id="chapters-community-gallery"
    eyebrow="COMMUNITY & CONNECTION"
    title="See the Community We're Building."
    description="Scenes from student gatherings and group activities. These photos are not a directory of approved campus chapters."
    photos={photoCollections.chapters}
    background="white"
  />


  <!-- ========================================
       START A CHAPTER
       ======================================== -->

  <section
    class="start-section"
    aria-labelledby="start-title"
  >
    <div class="page-container start-grid">

      <div class="start-content">

        <p class="eyebrow">
          BRING US TO YOUR CAMPUS
        </p>

        <h2 id="start-title">
          Your Campus Could
          <span>Be Next.</span>
        </h2>

        <p>
          Don't see your university listed?
          You could help bring Clear & Glowing
          to your campus.
        </p>

        <p>
          Starting a chapter is an opportunity
          to develop leadership skills,
          host educational experiences,
          build community, and make
          a meaningful impact.
        </p>

        <p>
          Learn about our chapter development
          process and the first steps
          toward bringing Clear & Glowing
          to your university.
        </p>

        <div class="start-actions">

          <Button
            href="/start-a-chapter"
            variant="primary"
          >
            Learn How to Start a Chapter
            <span aria-hidden="true">→</span>
          </Button>

        </div>

      </div>

      <div class="start-visual">

        <div class="start-visual-content">

          <p class="start-visual-eyebrow">
            LEAD THE NEXT CHAPTER
          </p>

          <p class="start-visual-headline">
            YOUR
            <span>CAMPUS.</span>
            YOUR GLOW.
          </p>

          <div class="start-visual-footer">

            <p>
              Build community.
              Inspire confidence.
              Make an impact.
            </p>

          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- ========================================
       FINAL CTA
       ======================================== -->

  <section
    class="community-cta"
    aria-labelledby="community-title"
  >
    <div class="page-container">

      <div class="cta-content">

        <p class="cta-eyebrow">
          STAY CONNECTED
        </p>

        <h2 id="community-title">
          Be Part of Something Bigger.
        </h2>

        <p>
          Whether you're an aspiring
          chapter founder or simply
          interested in our community,
          we'd love to keep you connected
          as Clear & Glowing grows.
        </p>

        <div class="cta-actions">

          <Button
            href="/start-a-chapter"
            variant="primary"
          >
            Start a Chapter
            <span aria-hidden="true">→</span>
          </Button>

          <Button
            href={links.newsletter}
            variant="outline-light"
          >
            Join Our Newsletter
          </Button>

        </div>

      </div>

    </div>
  </section>

</Layout>


<style>
  /* ========================================
     SHARED STYLES
     ======================================== */

  .page-container {
    width: min(
      calc(100% - 2rem),
      var(--max-content-width)
    );
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .section-heading h2 {
    margin: 0 0 1.5rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.85;
  }


  /* ========================================
     HERO
     ======================================== */

  .chapters-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-content h1 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .hero-content h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }


  /* ========================================
     HERO VISUAL
     ======================================== */

  .hero-visual {
    position: relative;
    isolation: isolate;
    display: flex;
    min-width: 0;
    min-height: 440px;

    background: linear-gradient(
      145deg,
      #BB0000,
      #850000 55%,
      #4B171C
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    z-index: -2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(145deg, rgb(36 0 0 / 0.87), rgb(20 10 13 / 0.83));
    pointer-events: none;
  }

  .hero-visual-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;

    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .visual-headline {
    margin: 0;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .visual-headline span {
    display: block;
  }

  .visual-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .visual-footer p:first-child {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 700;
  }

  .visual-footer p:last-child {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }


  /* ========================================
     CHAPTER DIRECTORY
     ======================================== */

  .directory-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .empty-state {
    max-width: 750px;
    padding: 2.5rem;
    background-color: var(--color-surface);
    border-radius: 12px;
  }

  .empty-state h3 {
    margin: 0 0 1rem;
    color: var(--color-heading);
    font-size: 1.5rem;
  }

  .empty-state p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.85;
  }

  .directory-note {
    max-width: 800px;
    margin-top: 2rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background-color: var(--color-surface);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 12px 12px 0;
  }

  .directory-note h3 {
    margin: 0 0 1rem;
    color: var(--color-heading);
    font-size: 1.35rem;
  }

  .directory-note p {
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.85;
  }

  .directory-note a {
    color: #990000;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .directory-note a:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }


  /* ========================================
     CHAPTER EXPERIENCES
     ======================================== */

  .experiences-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .experiences-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .experience-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);

    background-color: var(--color-white);
    border-top: 4px solid var(--color-primary);
    border-radius: 12px;
  }

  .experience-number {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .experience-card h3 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.3;
  }

  .experience-card p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.85;
  }


  /* ========================================
     START A CHAPTER
     ======================================== */

  .start-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-white);
  }

  .start-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .start-content h2 {
    margin: 0 0 2rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .start-content h2 span {
    display: block;
    color: var(--color-primary);
  }

  .start-content > p:not(.eyebrow) {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    line-height: 1.85;
  }

  .start-actions {
    margin-top: 2.5rem;
  }

  .start-visual {
    display: flex;
    min-width: 0;
    min-height: 430px;

    background: linear-gradient(
      135deg,
      #BB0000,
      #8A0000 55%,
      #4B171C
    );

    border-radius: 12px;
    overflow: hidden;
  }

  .start-visual-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;

    width: 100%;
    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .start-visual-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .start-visual-headline {
    margin: 0;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .start-visual-headline span {
    display: block;
  }

  .start-visual-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .start-visual-footer p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
  }


  /* ========================================
     FINAL CTA
     ======================================== */

  .community-cta {
    padding-block: clamp(4rem, 8vw, 7rem);
    background-color: #23191C;
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 850px;
    margin-inline: auto;
    text-align: center;
  }

  .cta-eyebrow {
    margin: 0 0 1.25rem;
    color: #FFCECE;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .cta-content h2 {
    margin: 0 0 2rem;
    color: var(--color-white);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .cta-content > p:not(.cta-eyebrow) {
    max-width: 650px;
    margin: 0;
    color: #E8E8E8;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }


  /* ========================================
     RESPONSIVE DESIGN
     ======================================== */

  @media (min-width: 640px) {
    .chapter-grid {
      grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
      );
    }

    .experiences-grid {
      grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
      );
    }
  }

  @media (min-width: 900px) {
    .hero-grid,
    .start-grid {
      grid-template-columns:
        minmax(0, 1.15fr)
        minmax(0, 0.85fr);
    }
  }

  @media (min-width: 1050px) {
    .chapter-grid {
      grid-template-columns: repeat(
        3,
        minmax(0, 1fr)
      );
    }
  }

  @media (max-width: 600px) {
    .hero-actions,
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-visual,
    .start-visual {
      min-height: 350px;
    }

    .visual-headline,
    .start-visual-headline {
      font-size: clamp(2.5rem, 9vw, 4rem);
    }
  }
</style>
