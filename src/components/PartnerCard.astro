---
import type { Partner } from "../data/partners";

interface Props {
  partner: Partner;
  headingLevel?: "h2" | "h3";
}

const {
  partner,
  headingLevel = "h3",
} = Astro.props;

const Heading = headingLevel;
---

{
  partner.approved && (
    <article class="partner-card">


      <div class="partner-logo">

        {
          partner.logo ? (
            <img
              src={partner.logo}
              alt=""
              width="400"
              height="200"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="logo-placeholder"
              aria-hidden="true"
            >
              <span class="placeholder-eyebrow">
                CLEAR & GLOWING
              </span>

              <span class="placeholder-text">
                COLLABORATION
              </span>
            </div>
          )
        }

      </div>



      <div class="partner-content">


        <div class="partner-meta">

          <span class="partner-relationship">
            {partner.relationship}
          </span>

        </div>



        <Heading class="partner-name">
          {partner.name}
        </Heading>



        <p class="partner-description">
          {partner.description}
        </p>



        {
          partner.website && (
            <a
              href={partner.website}
              class="partner-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit ${partner.name} website (opens in a new tab)`}
            >
              Visit {partner.name} Website

              <span aria-hidden="true">
                ↗
              </span>
            </a>
          )
        }

      </div>

    </article>
  )
}


<style>
  /* ========================================
     PARTNER CARD
     ======================================== */

  .partner-card {
    display: flex;
    flex-direction: column;

    min-width: 0;
    height: 100%;
    overflow: hidden;

    background-color: var(--color-white);
    border: 1px solid #E5E5E5;
    border-radius: 12px;

    transition:
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .partner-card:hover {
    border-color: #BBBBBB;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
  }


  /* ========================================
     PARTNER LOGO
     ======================================== */

  .partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-height: 160px;
    padding: 2rem;

    background-color: var(--color-surface);
  }

  .partner-logo img {
    display: block;

    width: 100%;
    max-width: 240px;
    max-height: 110px;
    height: auto;

    object-fit: contain;
  }


  /* ========================================
     LOGO PLACEHOLDER
     ======================================== */

  .logo-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;

    width: 100%;
    min-height: 110px;

    text-align: center;
  }

  .placeholder-eyebrow {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.12em;
  }

  .placeholder-text {
    color: var(--color-heading);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }


  /* ========================================
     PARTNER CONTENT
     ======================================== */

  .partner-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.85rem;

    padding: 1.5rem;
  }


  /* ========================================
     PARTNER RELATIONSHIP
     ======================================== */

  .partner-meta {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .partner-relationship {
    display: inline-block;

    padding: 0.35rem 0.85rem;

    background-color: #F9E5E5;
    color: #850000;
    border-radius: 100px;

    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
  }


  /* ========================================
     PARTNER NAME
     ======================================== */

  .partner-name {
    margin: 0;

    color: var(--color-heading);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;

    overflow-wrap: anywhere;
  }


  /* ========================================
     PARTNER DESCRIPTION
     ======================================== */

  .partner-description {
    margin: 0;

    color: var(--color-text);
    font-size: 0.925rem;
    line-height: 1.7;
  }


  /* ========================================
     PARTNER WEBSITE LINK
     ======================================== */

  .partner-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;

    margin-top: auto;
    padding-block: 0.75rem;

    color: #990000;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.5;

    text-decoration: underline;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .partner-link:hover {
    color: #660000;
  }

  .partner-link:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }


  /* ========================================
     REDUCED MOTION
     ======================================== */

  @media (prefers-reduced-motion: reduce) {
    .partner-card {
      transition: none;
    }
  }
</style>
