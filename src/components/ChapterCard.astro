---
import type { Chapter } from "../data/chapters";

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;

const statusLabels: Record<Chapter["status"], string> = {
  established: "Established Chapter",
  launching: "Launching Chapter",
  interest: "Chapter Interest",
};

const statusLabel = statusLabels[chapter.status];

const chapterLocation = [
  chapter.city,
  chapter.state,
].filter(Boolean).join(", ");
---

{
  chapter.approved && (
    <article class="chapter-card">


      <div class="chapter-visual">

        {
          chapter.image ? (
            <img
              src={chapter.image}
              alt=""
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="image-placeholder" aria-hidden="true">

              <span class="placeholder-eyebrow">
                CLEAR & GLOWING
              </span>

              <span class="placeholder-title">
                YOUR CAMPUS.
                <span>YOUR GLOW.</span>
              </span>

            </div>
          )
        }

      </div>



      <div class="chapter-content">

        <span class={`chapter-status status-${chapter.status}`}>
          {statusLabel}
        </span>

        <h3>
          {chapter.university}
        </h3>

        <p class="chapter-location">
          {chapterLocation}
        </p>

        {
          chapter.founded && (
            <p class="chapter-founded">
              Established: {chapter.founded}
            </p>
          )
        }

        {
          chapter.instagramUrl && (
            <div class="chapter-actions">

              <a
                href={chapter.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${chapter.university} chapter on Instagram (opens in a new tab)`}
              >
                Visit Chapter Instagram
                <span aria-hidden="true">↗</span>
              </a>

            </div>
          )
        }

      </div>

    </article>
  )
}


<style>
  /* ========================================
     CHAPTER CARD
     ======================================== */

  .chapter-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;

    background-color: var(--color-white);
    border: 1px solid #E5E5E5;
    border-radius: 12px;
    overflow: hidden;
  }


  /* ========================================
     IMAGE AREA
     ======================================== */

  .chapter-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;

    background-color: var(--color-primary);
    overflow: hidden;
  }

  .chapter-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;

    width: 100%;
    height: 100%;
    padding: 1.75rem;

    background: linear-gradient(
      145deg,
      #BB0000,
      #850000 55%,
      #4B171C
    );

    color: var(--color-white);
  }

  .placeholder-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .placeholder-title {
    font-size: clamp(1.5rem, 2.5vw, 2.3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .placeholder-title span {
    display: block;
  }


  /* ========================================
     CHAPTER INFORMATION
     ======================================== */

  .chapter-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;

    flex: 1;
    padding: 1.75rem;
  }

  .chapter-status {
    display: inline-block;
    padding: 0.45rem 0.85rem;

    background-color: #F3E5E5;
    color: #800000;
    border-radius: 100px;

    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .status-launching {
    background-color: #F9EED9;
    color: #684500;
  }

  .status-interest {
    background-color: #E8E8E8;
    color: #333333;
  }

  .chapter-content h3 {
    margin: 0.5rem 0 0;
    color: var(--color-heading);
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 800;
    line-height: 1.3;
  }

  .chapter-location {
    margin: 0;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .chapter-founded {
    margin: 0;
    color: #555555;
    font-size: 0.9rem;
    line-height: 1.6;
  }


  /* ========================================
     OPTIONAL INSTAGRAM LINK
     ======================================== */

  .chapter-actions {
    width: 100%;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .chapter-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    color: #990000;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.5;

    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .chapter-actions a:hover {
    color: #660000;
  }

  .chapter-actions a:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 3px;
  }

  @media (max-width: 600px) {
    .chapter-content {
      padding: 1.5rem;
    }

    .image-placeholder {
      padding: 1.5rem;
    }
  }
</style>
