---
import type { ClubEvent } from "../data/events";

interface Props {
  event: ClubEvent;
  headingLevel?: "h2" | "h3";
}

const {
  event,
  headingLevel = "h2",
} = Astro.props;

const Heading = headingLevel;

// Format ISO dates consistently, regardless of user timezone.
const formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${event.date}T00:00:00Z`));
---

<article class="event-card">

  <!-- Event Image -->
  <div class="event-image">
    {
      event.image ? (
        <img src={event.image}
          alt={event.imageAlt ?? ""}
          width="800"
          height="500"
          loading="lazy"
          decoding="async" />
      ) : (
        <div class="image-placeholder" aria-hidden="true">
          <span>Event Photo Coming Soon</span>
        </div>
      )
    }
  </div>

  <!-- Event Information -->
  <div class="event-content">

    <!-- Category and Date -->
    <div class="event-meta">
      <span class="event-category">
        {event.category}
      </span>

      <time datetime={event.date} class="event-date">
        {formattedDate}
      </time>
    </div>

    <!-- Event Title -->
    <Heading class="event-title">
      {event.title}
    </Heading>

    <!-- Location -->
    <p class="event-location">
      <svg width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true">
        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
          <circle cx="12" cy="10" r="2.5" />
        </svg>

        <span>{event.location}</span>
    </p>

    <!-- Description -->
    <p class="event-description">
      {event.description}
    </p>

  </div>
</article>

<style>
  /*
	================================================
	EVENT CARD
	================================================
	*/

  .event-card {
    display: flex;
    flex-direction: column;

    height: 100%;
    overflow: hidden;

    background-color: var(--color-white);
    border: 1px solid #E5E5E5;
    border-radius: 12px;
  }

  /*
	================================================
	EVENT IMAGE
	================================================
	*/

  .event-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;

    background-color: var(--color-surface);
  }

  .event-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;
    padding: 1.5rem;

    background: linear-gradient(
      135deg
      #F5F5F5,
      #EAEAEA
    );

    color: #595959;
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  /*
	================================================
	EVENT CONTENT
	================================================
	*/

  .event-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.85rem;

    padding: 1.5rem;
  }

  /*
	================================================
	CATEGORY AND DATE
	================================================
	*/

  .event-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .event-category {
    display: inline-block;
    
    padding: 0.35rem 0.75rem;

    background-color: #F9E5E5;
    color: #850000;
    border-radius: 100px;

    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .event-date {
    color: #595959;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /*
	================================================
	EVENT TITLE
	================================================
	*/

  .event-title {
    margin: 0;

    color: var(--color-heading);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;

    overflow-wrap: break-word;
  }

  /*
	================================================
	EVENT LOCATION
	================================================
	*/

  .event-location {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;

    margin: 0;

    color: #595959;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .event-location svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  /*
	================================================
	EVENT DESCRIPTION
	================================================
	*/

  .event-description {
    margin: 0;

    color: var(--color-text);
    font-size: 0.925rem;
    line-height: 1.7;
  }
</style>
