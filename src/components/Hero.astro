---
import Button from "./Button.astro";

interface HeroImage {
  src: string;
  alt: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  image?: HeroImage;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  eyebrow = "THE CLEAR & GLOWING FOUNDATION",
  title = "Confidence Looks Good on Everyone.",
  description = "More than skincare. We are building a community where education, confidence, wellness, and opportunity come together—on campus and beyond.",
  image,
  primaryText = "Discover Our Mission",
  primaryHref = "/about",
  secondaryText = "Start a Chapter",
  secondaryHref = "https://forms.gle/fABC1gMGKuboyEV46",
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">

  <!-- Background photograph -->
  {image && (
    <img src={image.src} alt={image.alt} class="hero-image" loading="eager" fetchpriority="high" decoding="async" />
    )}

    <!-- Dark overlay for text readability -->
    <div class="hero-overlay" aria-hidden="true"></div>

    <!-- Hero content -->
    <div class="hero-container">
      <div class="hero-content">

        <p class="hero-eyebrow">
          {eyebrow}
        </p>

        <h1 id="hero-title">
          {title}
        </h1>

        <p class="hero-description">
          {description}
        </p>

        <div class="hero-actions">
          <Button href={primaryHref} variant="primary">
            {primaryText}
          </Button>

          <Button href={secondaryHref} variant="outline-light">
            {secondaryText}
          </Button>
        </div>

        {!image && (
          <p class="image-notice">
            Community photograph placeholder
          </p>
        )}

      </div>
    </div>

</section>

<style>
  /*
	================================================
	HERO SECTION
	================================================
	*/

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: flex;
    align-items: center;

    width: 100%;
    min-height: 600px;
    min-height: min(780px, 85svh);

    background: linear-gradient(
      135deg,
      #56191D 0%,
      #21191B 55%,
      #111111 100%
    );

    color: var(--color-white);
  }

  /*
	================================================
	BACKGROUND IMAGE
	================================================
	*/

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: -2;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;

    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.72) 100%
    );

    pointer-events: none;;
  }

  /*
	================================================
	CONTENT CONTAINER
	================================================
	*/

  .hero-container {
    width: min(
      calc(100% - 2rem),
      var(--max-content-width)
    );

    margin-inline: auto;
    padding-block: 6rem;
  }

  .hero-content {
    max-width: 800px;
  }

  /*
	================================================
	TYPOGRAPHY
	================================================
	*/

  .hero-eyebrow {
    margin: 0 0 1.5rem;

    color: #F4C7C7;
    font-size: 0.8rem;
    font-weight: 700;

    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  h1 {
    margin: 0;

    color: var(--color-white);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }

  .hero-description {
    max-width: 640px;
    margin: 1.75rem 0 0;

    color: var(--color-white);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.8;
  }

  /*
	================================================
	BUTTONS
	================================================
	*/

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;

    margin-top: 2.5rem;
  }

  /*
	================================================
	TEMPORARY PHOTO PLACEHOLDER
	================================================
	*/

  .image-notice {
    margin-top: 3rem;

    color: #E0E0E0;
    font-size: 0.75rem;
    font-style: italic;
  }

  /*
	================================================
	RESPONSIVE DESIGN
	================================================
	*/

  @media (max-width: 600px) {
    .hero {
      min-height: 600px;
    }

    .hero-container {
      padding-block: 5rem;
    }

    .hero-eyebrow {
      font-size: 0.7rem;
    }

    .hero-description {
      margin-top: 1.5rem;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-actions :global(.button) {
      width: 100%;
    }
  }
</style>
