---
import Button from "./Button.astro";

interface HeroImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  image?: HeroImage;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  eyebrow = "CLEAR & GLOWING",
  title = "Confidence Looks Good on Everyone.",
  description =
    "More than skincare. We are building a community where education, confidence, wellness, and opportunity come together—on campus and beyond.",
  image,
  primaryText = "Discover Our Mission",
  primaryHref = "/about",
  secondaryText = "Start a Chapter",
  secondaryHref = "/start-a-chapter",
} = Astro.props;
---

<section
  class="hero"
  aria-labelledby="hero-title"
>


  {
    image && (
      <>
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          class="hero-image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />


        <div
          class="hero-overlay"
          aria-hidden="true"
        />
      </>
    )
  }



  <div class="hero-container">

    <div class="hero-content">


      <p class="hero-eyebrow">
        {eyebrow}
      </p>



      <h1 id="hero-title">
        {title}
      </h1>



      <p class="hero-description">
        {description}
      </p>



      <div class="hero-actions">

        <Button
          href={primaryHref}
          variant="primary"
        >
          {primaryText}
        </Button>


        <Button
          href={secondaryHref}
          variant="outline-light"
        >
          {secondaryText}
        </Button>

      </div>

    </div>

  </div>

</section>


<style>
  /* ========================================
     HERO SECTION
     ======================================== */

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: flex;
    align-items: center;

    width: 100%;
    min-height: clamp(34rem, 85svh, 48.75rem);

    background: linear-gradient(
      135deg,
      #56191D 0%,
      #21191B 55%,
      #111111 100%
    );

    color: var(--color-white);
  }


  /* ========================================
     BACKGROUND PHOTOGRAPH
     ======================================== */

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: -2;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }


  /* ========================================
     IMAGE OVERLAY
     Only rendered when an image is present
     ======================================== */

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;

    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.85) 0%,
      rgb(0 0 0 / 0.72) 100%
    );

    pointer-events: none;
  }


  /* ========================================
     CONTENT CONTAINER
     ======================================== */

  .hero-container {
    width: min(
      calc(100% - 2rem),
      var(--max-content-width)
    );

    margin-inline: auto;
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .hero-content {
    position: relative;
    z-index: 1;

    max-width: 800px;
  }


  /* ========================================
     EYEBROW
     ======================================== */

  .hero-eyebrow {
    margin: 0 0 1.5rem;

    color: #F4C7C7;

    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.12em;
  }


  /* ========================================
     MAIN HEADING
     ======================================== */

  .hero h1 {
    margin: 0;

    color: var(--color-white);

    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;

    overflow-wrap: break-word;
  }


  /* ========================================
     DESCRIPTION
     ======================================== */

  .hero-description {
    max-width: 640px;
    margin: 1.75rem 0 0;

    color: var(--color-white);

    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.8;
  }


  /* ========================================
     HERO BUTTONS
     ======================================== */

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 1rem;
    margin-top: 2.5rem;
  }


  /* ========================================
     MOBILE RESPONSIVE DESIGN
     ======================================== */

  @media (max-width: 600px) {
    .hero {
      min-height: 34rem;
    }

    .hero-container {
      padding-block: 5rem;
    }

    .hero-eyebrow {
      font-size: 0.7rem;
    }

    .hero-description {
      margin-top: 1.5rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions :global(.button) {
      width: 100%;
    }
  }


  /* ========================================
     REDUCED MOTION
     ======================================== */

  @media (prefers-reduced-motion: reduce) {
    .hero {
      scroll-behavior: auto;
    }
  }
</style>
