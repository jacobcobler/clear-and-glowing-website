---
import Button from "./Button.astro";

interface MissionImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  image?: MissionImage;
}

const { image } = Astro.props;
---

<section
  class="mission"
  aria-labelledby="mission-title"
>

  <div class="mission-container">

    <!-- ========================================
         MISSION CONTENT
         ======================================== -->

    <div class="mission-content">

      <p class="mission-eyebrow">
        MORE THAN SKINCARE
      </p>


      <h2 id="mission-title">
        Your Skin Does Not Define Your Worth.
      </h2>


      <p class="mission-description">
        Clear & Glowing began with a simple idea:
        skincare should be a conversation about more
        than appearance. Through educational events,
        supportive communities, philanthropic initiatives,
        and connections to beauty-industry professionals,
        we help students feel informed, included, and
        empowered to lead.
      </p>


      <!-- Mission CTA -->

      <div class="mission-action">

        <Button
          href="/our-story"
          variant="primary"
        >
          Read Our Story

          <span aria-hidden="true">
            →
          </span>
        </Button>

      </div>

    </div>


    <!-- ========================================
         MISSION PHOTOGRAPH / PLACEHOLDER
         ======================================== -->

    <div class="mission-media">

      {
        image ? (

          <img
            src={image.src}
            alt={image.alt}
            width={image.width ?? 800}
            height={image.height ?? 1000}
            loading="lazy"
            decoding="async"
          />

        ) : (

          <div
            class="image-placeholder"
            aria-hidden="true"
          >

            <p class="placeholder-eyebrow">
              CLEAR & GLOWING
            </p>

            <div class="placeholder-message">

              <p class="placeholder-title">
                MORE THAN
                <span>SKINCARE.</span>
              </p>

              <p class="placeholder-subtitle">
                EDUCATION. CONFIDENCE.
                COMMUNITY.
              </p>

            </div>

            <p class="placeholder-footer">
              YOUR GLOW. YOUR STORY.
            </p>

          </div>

        )
      }

    </div>

  </div>

</section>


<style>
  /* ========================================
     MISSION SECTION
     ======================================== */

  .mission {
    width: 100%;

    padding-block: clamp(4rem, 8vw, 7rem);

    background-color: var(--color-white);
  }


  /* ========================================
     MISSION CONTAINER
     ======================================== */

  .mission-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    align-items: center;
    gap: 3rem;

    width: min(
      calc(100% - 2rem),
      var(--max-content-width)
    );

    margin-inline: auto;
  }


  /* ========================================
     MISSION CONTENT
     ======================================== */

  .mission-content {
    max-width: 600px;
    min-width: 0;
  }


  /* ========================================
     MISSION EYEBROW
     ======================================== */

  .mission-eyebrow {
    margin: 0 0 1.25rem;

    color: var(--color-primary);

    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.12em;
  }


  /* ========================================
     MISSION HEADING
     ======================================== */

  .mission-content h2 {
    margin: 0;

    color: var(--color-heading);

    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }


  /* ========================================
     MISSION DESCRIPTION
     ======================================== */

  .mission-description {
    margin: 1.75rem 0 0;

    color: var(--color-text);

    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.85;
  }


  /* ========================================
     CALL TO ACTION
     ======================================== */

  .mission-action {
    margin-top: 2rem;
  }


  /* ========================================
     MISSION MEDIA
     ======================================== */

  .mission-media {
    width: 100%;
    min-width: 0;
    aspect-ratio: 4 / 5;

    overflow: hidden;

    background-color: var(--color-surface);
    border-radius: 12px;
  }

  .mission-media img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }


  /* ========================================
     BRANDED IMAGE PLACEHOLDER
     ======================================== */

  .image-placeholder {
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    gap: 2rem;

    width: 100%;
    height: 100%;
    min-height: 0;

    padding: clamp(1.5rem, 4vw, 3rem);

    background: linear-gradient(
      145deg,
      #BB0000 0%,
      #850000 55%,
      #4B171C 100%
    );

    color: var(--color-white);
  }


  /* ========================================
     PLACEHOLDER TEXT
     ======================================== */

  .placeholder-eyebrow {
    margin: 0;

    color: var(--color-white);

    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.12em;
  }

  .placeholder-message {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .placeholder-title {
    margin: 0;

    color: var(--color-white);

    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;

    overflow-wrap: anywhere;
  }

  .placeholder-title span {
    display: block;
  }

  .placeholder-subtitle {
    max-width: 260px;
    margin: 0;

    color: #FFE6E6;

    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  .placeholder-footer {
    margin: 0;
    padding-top: 1.25rem;

    color: var(--color-white);

    border-top: 1px solid rgb(255 255 255 / 0.4);

    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.08em;
  }


  /* ========================================
     DESKTOP RESPONSIVE DESIGN
     ======================================== */

  @media (min-width: 768px) {
    .mission-container {
      grid-template-columns:
        minmax(0, 1.1fr)
        minmax(0, 0.9fr);

      gap: clamp(3rem, 6vw, 6rem);
    }
  }


  /* ========================================
     MOBILE RESPONSIVE DESIGN
     ======================================== */

  @media (max-width: 767px) {
    .mission-media {
      max-width: 550px;
      aspect-ratio: 4 / 3;
    }

    .placeholder-title {
      font-size: clamp(1.7rem, 6vw, 2.5rem);
    }
  }

  @media (max-width: 400px) {
    .image-placeholder {
      gap: 1rem;
      padding: 1.25rem;
    }

    .placeholder-title {
      font-size: 1.6rem;
    }

    .placeholder-subtitle,
    .placeholder-footer {
      font-size: 0.7rem;
    }
  }
</style>
